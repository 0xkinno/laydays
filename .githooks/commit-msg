#!/usr/bin/env bash
# Removes AI attribution lines from every commit message.
msg_file="$1"
sed -i.bak -E '/^[[:space:]]*Co-Authored-By:.*([Cc]laude|[Aa]nthropic)/d; /^[[:space:]]*Claude-Session:/d; /[Gg]enerated with.*[Cc]laude [Cc]ode/d; /noreply@anthropic\.com/d' "$msg_file"
rm -f "$msg_file.bak"
